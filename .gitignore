# --- Data and Databases ---
# Ignore ChromaDB data
infra/chromadb/chroma_data/
infra/chromadb/chroma.sqlite3

# Ignore Neo4j data and internal locks
infra/neo4j/neo4j_data/
**/database_lock
**/store_lock

# --- AI Models and Caches ---
# Ignore Hugging Face model caches (these are very large)
**/hf_cache/

# --- Logs ---
# Ignore all log files generated by the services
**/*.log
services/*/logs/
infra/*/logs/

# --- Python & Environment ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
.env

# --- Local Scripts and Temp files ---
# Since this is a public repo, you might want to ignore 
# temporary text dumps and local notes
codebase_1.txt
notes.txt
command.txt

# --- OS Specific ---
.DS_Store
Thumbs.db